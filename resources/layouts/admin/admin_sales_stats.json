        "basis": "{{query.basis || ''}}",
        "compare": "{{query.compare || ''}}"
      },
      "fallback": {
        "data": {
          "tabs": [
            {
              "id": "overview",
              "label": "$t:custom-sales_stats.tabs.overview"
            }
          ],
          "presets": [],
          "filters": {},
          "can": {},
          "available": {},
          "market_categories": []
        }
      },
      "errorHandling": {
        "403": {
          "handler": "toast",
