                    "partial": "partials/admin_sales_stats/_tab_ecommerce.json"
                  }
                ]
              },
              {
                "id": "sales_stats_market_wrap",
                "type": "basic",
                "name": "Div",
                "if": "{{(query.tab || 'overview') === 'market'}}",
                "children": [
                  {
                    "partial": "partials/admin_sales_stats/_tab_market.json"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
